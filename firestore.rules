rules_version = '2';
// ═══════════════════════════════════════════════════════════════════
// KONFÍO ZINC · Reglas de Firestore — panel con roles
//
// Principio: DENEGAR POR DEFECTO. El rol se lee de `usuarios/{uid}.rol`
// (nunca del frontend). La autoridad real de negocio son las Cloud
// Functions (que corren con Admin SDK y se saltan estas reglas), por lo
// que las ESCRITURAS de negocio están cerradas desde el cliente: así se
// garantiza auditoría, historial de estados y anti-duplicado de avisos.
//
// Roles: OPERADOR(1) < ADMIN(2) < SUPERADMIN(3)
// ═══════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────
    function estaAutenticado() { return request.auth != null; }

    function fichaUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function rol() {
      return estaAutenticado() ? fichaUsuario().rol : '';
    }

    function estaActivo() {
      return estaAutenticado() && fichaUsuario().activo == true;
    }

    function esOperador() { return estaActivo() && rol() in ['OPERADOR', 'ADMIN', 'SUPERADMIN']; }
    function esAdmin() { return estaActivo() && rol() in ['ADMIN', 'SUPERADMIN']; }
    function esSuperadmin() { return estaActivo() && rol() == 'SUPERADMIN'; }

    // ── usuarios (administradores) ──────────────────────────────────
    // Lectura: cada uno se ve a sí mismo; el resto lo ve un SUPERADMIN.
    // Escritura: cerrada al cliente — los cambios los hace crearUsuario /
    // actualizarUsuario (Cloud Functions con Admin SDK).
    match /usuarios/{uid} {
      allow read: if (estaAutenticado() && request.auth.uid == uid) || esSuperadmin();
      allow write: if false;
    }

    // ── clientes ────────────────────────────────────────────────────
    match /clientes/{clienteId} {
      allow read: if esOperador();
      allow write: if false; // pasa por crearCliente / actualizarCliente
    }

    // ── servicios (instancias por cliente) ──────────────────────────
    match /servicios/{servicioId} {
      allow read: if esOperador();
      allow write: if false; // pasa por las funciones de ciclo de vida
    }

    // ── pagos ───────────────────────────────────────────────────────
    match /pagos/{pagoId} {
      allow read: if esOperador();
      allow write: if false; // pasa por registrarPago / confirmarPago / anularPago
    }

    // ── planes ──────────────────────────────────────────────────────
    match /planes/{planId} {
      allow read: if esOperador();
      allow write: if false; // el catálogo lo gestiona ADMIN+ vía Admin SDK
    }

    // ── notificaciones ──────────────────────────────────────────────
    match /notificaciones/{notificacionId} {
      allow read: if esAdmin();
      allow write: if false; // solo el motor y enviarNotificacion
    }

    // ── tokens_notificacion ─────────────────────────────────────────
    // El panel registra el token de SU dispositivo, con el id del token
    // como documento para que sea idempotente.
    match /tokens_notificacion/{token} {
      allow read: if esOperador();
      allow create, update: if estaAutenticado()
        && request.resource.data.clienteId is string
        && request.resource.data.token is string;
      allow delete: if esAdmin();
    }

    // ── historial_estados ───────────────────────────────────────────
    match /historial_estados/{id} {
      allow read: if esOperador();
      allow write: if false; // lo escribe el Admin SDK
    }

    // ── auditoria ───────────────────────────────────────────────────
    match /auditoria/{id} {
      allow read: if esSuperadmin();
      allow write: if false; // lo escribe el Admin SDK
    }

    // ── configuracion ───────────────────────────────────────────────
    match /configuracion/{clave} {
      allow read: if esAdmin();
      allow write: if false; // solo SUPERADMIN vía Admin SDK
    }

    // ── Denegar todo lo demás ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
