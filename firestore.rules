rules_version = '2';
// ═══════════════════════════════════════════════════════════════════
// KONFÍO ZINC · Reglas de Firestore — panel en MODO SPARK
//
// El proyecto está en el plan gratuito Spark, que NO permite Cloud Functions.
// Por eso el panel escribe directo en Firestore y TODA la autorización vive
// aquí. El rol se lee de `usuarios/{uid}.rol` (o de la ficha heredada
// `usuarios/{correo}` mientras no se vincule), nunca de una variable que el
// navegador pueda inventar.
//
// Garantías:
//   · Solo usuarios autenticados, con ficha y `activo == true`.
//   · El rol sale de Firestore; el navegador no puede subirse de rol:
//     `usuarios` es de SOLO LECTURA desde el cliente.
//   · El dinero es inmutable: `monto`, cliente y quién registró un pago no
//     cambian para nadie. Corregir un importe = anular y registrar otro.
//   · Pagos: solo tres transiciones y una sola vez (PENDIENTE→CONFIRMADO,
//     PENDIENTE→ANULADO, CONFIRMADO→ANULADO). Confirmar dos veces es imposible.
//   · Clientes: OPERADOR edita datos de contacto; los campos comerciales
//     (servicio, plan, precio, fechas, estado) son de ADMIN; la baja lógica
//     (`eliminado`) es de SUPERADMIN.
//   · Auditoría e historial: se crean, nunca se modifican ni se borran.
//   · Notificaciones: el panel solo REGISTRA avisos preparados; marcarlos
//     enviados es un acto explícito del operador. Nada se envía solo.
// ═══════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    /* ── Identidad y rol ───────────────────────────────────────────── */
    function estaAutenticado() { return request.auth != null; }

    function correo() {
      return estaAutenticado() && request.auth.token.email != null
        ? request.auth.token.email : '__sin_correo__';
    }

    /* Ficha del usuario: primero por uid (modelo nuevo) y, si no existe, por
       correo (fichas heredadas de antes de la vinculación). Esto permite
       operar sin migrar datos: el día que se ejecuta la herramienta local de
       vinculación, la ficha por correo desaparece y todo sigue igual.

       Las dos lecturas se hacen UNA vez por evaluación (`let`): cada get()
       cuenta para el límite de 10 por petición, y encadenar helpers que
       vuelven a leer la misma ficha agotaba ese límite y hacía que las reglas
       denegaran operaciones legítimas. */
    function porUid() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function porCorreo() {
      return get(/databases/$(database)/documents/usuarios/$(correo()));
    }

    /* El rol se resuelve con dos lecturas: la ficha del UID y, si esa no da un
       rol válido, la ficha heredada por correo. Se comparan los CAMPOS
       directamente y NO se usa .exists: en este motor .exists devuelve falso
       incluso cuando el documento existe, y eso denegaba operaciones
       legítimas. Un documento ausente produce un error que no tumba la
       expresión: la rama del correo se evalúa igual (comprobado con sonda). */
    function esOperador() {
      return estaAutenticado() && (
        (porUid().data.get('activo', false) == true
          && porUid().data.get('rol', '') in ['OPERADOR', 'ADMIN', 'SUPERADMIN'])
        || (porCorreo().data.get('activo', false) == true
          && porCorreo().data.get('rol', '') in ['OPERADOR', 'ADMIN', 'SUPERADMIN'])
      );
    }

    function esAdmin() {
      return estaAutenticado() && (
        (porUid().data.get('activo', false) == true
          && porUid().data.get('rol', '') in ['ADMIN', 'SUPERADMIN'])
        || (porCorreo().data.get('activo', false) == true
          && porCorreo().data.get('rol', '') in ['ADMIN', 'SUPERADMIN'])
      );
    }

    function esSuperadmin() {
      return estaAutenticado() && (
        (porUid().data.get('activo', false) == true
          && porUid().data.get('rol', '') == 'SUPERADMIN')
        || (porCorreo().data.get('activo', false) == true
          && porCorreo().data.get('rol', '') == 'SUPERADMIN')
      );
    }



    /* ── Utilidades de esquema ─────────────────────────────────────── */
    function textoNoVacio(v) { return v is string && v.size() > 0; }
    function fechaTexto(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function estadoValido(v) {
      return v in ['ACTIVO', 'POR_VENCER', 'PENDIENTE_PAGO', 'SUSPENDIDO',
                   'INACTIVO', 'INHABILITADO', 'PENDIENTE_CONFIGURACION'];
    }
    function tocados() { return request.resource.data.diff(resource.data).affectedKeys(); }

    /* ── usuarios ──────────────────────────────────────────────────── */
    // Lectura: cada uno su ficha (por uid o, si es heredada, por correo);
    // los SUPERADMIN ven todas. Escritura: NADIE desde el navegador. Crear una
    // cuenta, cambiar un rol o vincular un uid exige el Admin SDK, es decir la
    // herramienta local privilegiada (herramientas/admin-spark.js).
    match /usuarios/{clave} {
      allow read: if estaAutenticado() && (request.auth.uid == clave || correo() == clave || esSuperadmin());
      allow write: if false;
    }

    /* ── clientes ──────────────────────────────────────────────────── */
    // OPERADOR: datos de contacto. ADMIN+: lo comercial y el ciclo de vida.
    // SUPERADMIN: la baja lógica. Borrado físico: nunca.
    match /clientes/{clienteId} {

      function contactoOperador() {
        return tocados().hasOnly([
          'nombre', 'empresa', 'documento', 'telefono', 'whatsapp', 'email',
          'ciudad', 'observaciones', 'updatedAt'
        ]);
      }
      function comercialAdmin() {
        return tocados().hasOnly([
          'nombre', 'empresa', 'documento', 'telefono', 'whatsapp', 'email',
          'ciudad', 'observaciones', 'metodoPagoPreferido',
          'servicio', 'categoria', 'planId', 'planNombre', 'precio',
          'fechaActivacion', 'fechaVencimiento', 'urlServicio', 'proyectoId',
          'estadoCliente', 'estadoServicio', 'fechaCambioEstado', 'motivoCambio',
          'cambiadoPor', 'fechaSuspension', 'fechaReactivacion',
          'fechaInhabilitacion', 'activo', 'updatedAt'
        ]);
      }
      function tiposValidos() {
        return request.resource.data.get('precio', 0) is number
            && request.resource.data.get('precio', 0) >= 0
            && fechaTexto(request.resource.data.get('fechaActivacion', '2000-01-01'))
            && fechaTexto(request.resource.data.get('fechaVencimiento', '2000-01-01'))
            && estadoValido(request.resource.data.get('estadoCliente', 'ACTIVO'))
            && estadoValido(request.resource.data.get('estadoServicio', 'ACTIVO'));
      }
      function sinEliminar() {
        return request.resource.data.get('eliminado', false) == resource.data.get('eliminado', false);
      }

      allow read: if esOperador();
      allow create: if esOperador()
        && textoNoVacio(request.resource.data.get('nombre', ''))
        && textoNoVacio(request.resource.data.get('servicio', ''))
        && textoNoVacio(request.resource.data.get('telefono', ''))
        && request.resource.data.get('precio', 0) is number
        && request.resource.data.get('precio', 0) >= 0
        && fechaTexto(request.resource.data.get('fechaActivacion', '2000-01-01'))
        && fechaTexto(request.resource.data.get('fechaVencimiento', '2000-01-01'))
        && request.resource.data.get('eliminado', false) == false;
      allow update: if esOperador() && (
          (esAdmin() && comercialAdmin() && tiposValidos() && sinEliminar())
          || (contactoOperador() && sinEliminar())
          || (esSuperadmin()
              && tocados().hasOnly(['eliminado', 'activo', 'estadoCliente', 'estadoServicio',
                                    'fechaEliminacion', 'motivoCambio', 'fechaCambioEstado',
                                    'cambiadoPor', 'updatedAt'])
              && request.resource.data.get('eliminado', false) == true
              && request.resource.data.get('estadoCliente', '') == 'INHABILITADO')
        );
      allow delete: if false;
    }

    /* ── servicios ─────────────────────────────────────────────────── */
    // KZ-SEC-002: un OPERADOR solo puede ajustar datos de contacto del
    // servicio (clienteNombre). Los campos COMERCIALES (precio, fechas, plan,
    // estado, activo) los toca únicamente ADMIN+, y con tipos válidos. La
    // autorización vive aquí, no en los botones del panel.
    match /servicios/{servicioId} {
      function camposContacto() {
        return tocados().hasOnly(['clienteNombre', 'updatedAt']);
      }
      function camposComerciales() {
        return tocados().hasOnly(['clienteNombre', 'planId', 'servicio', 'categoria',
                                  'fechaInicio', 'fechaVencimiento', 'precio', 'estado',
                                  'activo', 'updatedAt']);
      }
      allow read: if esOperador();
      allow create: if esOperador()
        && textoNoVacio(request.resource.data.get('clienteId', ''))
        && textoNoVacio(request.resource.data.get('servicio', ''))
        && request.resource.data.keys().hasOnly([
             'clienteId', 'clienteNombre', 'planId', 'servicio', 'categoria',
             'fechaInicio', 'fechaVencimiento', 'precio', 'estado', 'activo', 'updatedAt'
           ])
        && request.resource.data.get('precio', 0) is number
        && request.resource.data.get('precio', 0) >= 0;
      allow update: if esOperador()
        && request.resource.data.get('clienteId', '') == resource.data.get('clienteId', '')
        && (
          camposContacto()
          || (esAdmin() && camposComerciales()
              && request.resource.data.get('precio', 0) is number
              && request.resource.data.get('precio', 0) >= 0)
        );
      allow delete: if false;
    }

    /* ── pagos ─────────────────────────────────────────────────────── */
    match /pagos/{pagoId} {

      function dineroIntacto() {
        return request.resource.data.get('monto', null) == resource.data.get('monto', null)
            && request.resource.data.get('clienteId', null) == resource.data.get('clienteId', null)
            && request.resource.data.get('clienteNombre', null) == resource.data.get('clienteNombre', null)
            && request.resource.data.get('servicioId', null) == resource.data.get('servicioId', null)
            && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
            && request.resource.data.get('registradoPor', null) == resource.data.get('registradoPor', null)
            && request.resource.data.get('registradoPorNombre', null) == resource.data.get('registradoPorNombre', null);
      }
      function camposPermitidos() {
        return tocados().hasOnly([
          'estado', 'metodoPago', 'fechaPago', 'referencia', 'comprobanteUrl',
          'confirmadoPor', 'confirmadoPorNombre', 'periodoInicio', 'periodoFin',
          'confirmadoEn', 'anuladoPor', 'motivo', 'anuladoEn'
        ]);
      }
      function transicionAutorizada() {
        return (resource.data.get('estado', '') == 'PENDIENTE' && request.resource.data.estado == 'CONFIRMADO')
            || (resource.data.get('estado', '') == 'PENDIENTE' && request.resource.data.estado == 'ANULADO')
            || (resource.data.get('estado', '') == 'CONFIRMADO' && request.resource.data.estado == 'ANULADO');
      }
      function auditoriaCoherente() {
        return (request.resource.data.estado == 'CONFIRMADO'
                 && request.resource.data.confirmadoPor == request.auth.uid
                 && request.resource.data.confirmadoEn is timestamp
                 && fechaTexto(request.resource.data.get('periodoFin', '2000-01-01'))
                 && !tocados().hasAny(['anuladoPor', 'anuladoEn', 'motivo']))
            || (request.resource.data.estado == 'ANULADO'
                 && request.resource.data.anuladoPor == request.auth.uid
                 && textoNoVacio(request.resource.data.get('motivo', ''))
                 && request.resource.data.anuladoEn is timestamp
                 && !tocados().hasAny(['confirmadoPor', 'confirmadoPorNombre',
                                       'periodoInicio', 'periodoFin', 'confirmadoEn']));
      }
      function soloMetadatos() {
        return resource.data.get('estado', '') != 'ANULADO'
            && request.resource.data.estado == resource.data.get('estado', '')
            && !tocados().hasAny(['confirmadoPor', 'confirmadoPorNombre', 'periodoInicio',
                                  'periodoFin', 'confirmadoEn', 'anuladoPor', 'motivo', 'anuladoEn']);
      }

      allow read: if esOperador();
      allow create: if esOperador()
        && request.resource.data.get('estado', '') == 'PENDIENTE'
        && request.resource.data.get('monto', 0) is number
        && request.resource.data.get('monto', 0) > 0
        && textoNoVacio(request.resource.data.get('clienteId', ''))
        && fechaTexto(request.resource.data.get('fechaPago', '2000-01-01'))
        && request.resource.data.get('registradoPor', '') == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'clienteId', 'clienteNombre', 'servicioId', 'monto', 'metodoPago',
             'fechaPago', 'referencia', 'comprobanteUrl', 'estado',
             'registradoPor', 'registradoPorNombre', 'createdAt'
           ]);
      allow update: if esAdmin()
        && dineroIntacto()
        && camposPermitidos()
        && ((transicionAutorizada() && auditoriaCoherente()) || soloMetadatos());
      allow delete: if false;
    }

    /* ── planes ────────────────────────────────────────────────────── */
    match /planes/{planId} {
      allow read: if esOperador();
      allow create, update: if esAdmin()
        && textoNoVacio(request.resource.data.get('nombre', ''))
        && textoNoVacio(request.resource.data.get('servicio', ''))
        && request.resource.data.get('precio', 0) is number
        && request.resource.data.get('precio', 0) >= 0;
      allow delete: if esAdmin();
    }

    /* ── notificaciones ────────────────────────────────────────────── */
    // En Spark no hay motor: el panel PREPARA el aviso (estado PREPARADA) y el
    // operador lo envía a mano por WhatsApp. Marcar ENVIADA es un acto
    // explícito y queda registrado con quién y cuándo. Nada se envía solo.
    match /notificaciones/{notificacionId} {
      allow read: if esOperador();
      allow create: if esOperador()
        && request.resource.data.get('estado', '') == 'PREPARADA'
        && request.resource.data.get('canal', '') in ['MANUAL', 'WHATSAPP']
        && textoNoVacio(request.resource.data.get('clienteId', ''))
        && textoNoVacio(request.resource.data.get('mensaje', ''))
        && request.resource.data.get('usuarioId', '') == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'clienteId', 'clienteNombre', 'tipo', 'mensaje', 'estado', 'canal',
             'usuarioId', 'usuarioNombre', 'preparadaEn'
           ]);
      allow update: if esOperador()
        && request.resource.data.estado == 'ENVIADA'
        && request.resource.data.get('enviadoPor', '') == request.auth.uid
        && request.resource.data.enviadoEn is timestamp
        && tocados().hasOnly(['estado', 'enviadoPor', 'enviadoEn']);
      allow delete: if false;
    }

    /* ── tokens_notificacion ───────────────────────────────────────── */
    // KZ-SEC-002: solo el panel (OPERADOR+) gestiona tokens, el id del
    // documento debe ser el propio token y no se admiten campos arbitrarios.
    // Un usuario autenticado cualquiera ya no puede inyectar tokens ajenos.
    match /tokens_notificacion/{token} {
      allow read: if esOperador();
      allow create, update: if esOperador()
        && textoNoVacio(request.resource.data.get('clienteId', ''))
        && request.resource.data.get('token', '') == token
        && request.resource.data.keys().hasOnly([
             'clienteId', 'token', 'plataforma', 'navegador', 'activo',
             'fechaRegistro', 'ultimaActividad'
           ]);
      allow delete: if esAdmin();
    }

    /* ── historial_estados ─────────────────────────────────────────── */
    // El panel lo escribe en cada cambio de estado; se lee desde la ficha del
    // cliente. Nunca se modifica ni se borra.
    match /historial_estados/{id} {
      allow read: if esOperador();
      allow create: if esOperador()
        && textoNoVacio(request.resource.data.get('clienteId', ''))
        && estadoValido(request.resource.data.get('estadoNuevo', 'ACTIVO'))
        && request.resource.data.get('usuarioId', '') == request.auth.uid;
      allow update, delete: if false;
    }

    /* ── auditoria ─────────────────────────────────────────────────── */
    match /auditoria/{id} {
      allow read: if esSuperadmin();
      allow create: if esOperador()
        && textoNoVacio(request.resource.data.get('accion', ''))
        && textoNoVacio(request.resource.data.get('entidad', ''))
        && request.resource.data.get('usuarioId', '') == request.auth.uid;
      allow update, delete: if false;
    }

    /* ── configuracion ─────────────────────────────────────────────── */
    // `motorVencimientos` no se toca desde el navegador ni con SUPERADMIN: si
    // algún día se activa Blaze, ese interruptor se abre solo con Admin SDK.
    match /configuracion/{clave} {
      allow read: if esOperador();
      allow write: if esSuperadmin() && clave != 'motorVencimientos';
    }

    /* ── contactos (formulario público del sitio) ──────────────────── */
    // KZ-SEC-002: creación pública con lista cerrada de campos, tamaños
    // máximos y formato de correo. El formulario premium escribe aquí; el
    // panel los lee. Sin campos arbitrarios ni mensajes gigantes.
    match /contactos/{contactoId} {
      allow create: if true
        && request.resource.data.keys().hasOnly(
             ['nombre', 'email', 'telefono', 'mensaje', 'servicio', 'pagina',
              'origen', 'estado', 'createdAt', 'consentimiento']
           )
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 1
        && request.resource.data.nombre.size() <= 120
        && (!('email' in request.resource.data)
             || (request.resource.data.email is string
                 && request.resource.data.email.size() > 3
                 && request.resource.data.email.size() <= 200
                 && request.resource.data.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')))
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() > 1
        && request.resource.data.mensaje.size() <= 2000
        && (!('telefono' in request.resource.data)
             || (request.resource.data.telefono is string
                 && request.resource.data.telefono.size() <= 40));
      allow read: if esOperador();
      allow update, delete: if esAdmin();
    }

    /* ── suscriptores_web (avisos push de los visitantes) ──────────── */
    match /suscriptores_web/{token} {
      allow create: if true
        && request.resource.data.token is string
        && request.resource.data.token == token
        && request.resource.data.token.size() > 40
        && request.resource.data.keys().hasOnly(
             ['token','creadoEn','origen','pagina','idioma','plataforma','activo']
           );
      allow update: if true
        && request.resource.data.token == token
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['creadoEn','pagina','idioma','plataforma','activo']);
      allow read: if esOperador();
      allow delete: if esAdmin();
    }

    /* ── eventos (analítica de las tarjetas) ───────────────────────── */
    match /eventos/{id} {
      allow create: if true
        && request.resource.data.tarjeta is string
        && request.resource.data.evento is string
        && request.resource.data.keys().hasOnly(['tarjeta','evento','etiqueta','pagina','ts','ua']);
      allow read: if esOperador();
      allow update, delete: if false;
    }

    /* ── Denegar todo lo demás ─────────────────────────────────────── */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
