#!/bin/sh
# Pre-commit hook: bloquea Google API Keys y patrones de secreto en commits nuevos.
#
# Las claves listadas aquí son apiKey de app web de Firebase: Google las publica en
# cualquier cliente y NO son secretos. Lo que protege los datos son las reglas de
# Firestore. Cualquier OTRA clave sí se bloquea.
#   · AIzaSyDbw... → proyecto konfio-zinc   (sitio de la agencia)
#   · AIzaSyAeT... → proyecto kzfio-crm     (CRM comercial, base «default», 2-nov-2026)
KNOWN_KEY="AIzaSyDbwAk9APwP2SeaEfWxeQG_bdL9eatciEA"
ALLOWED_KEYS="AIzaSyDbwAk9APwP2SeaEfWxeQG_bdL9eatciEA AIzaSyAeTUIAcqHz0pFuNLpxpg6MiboA-PgdLe4"

added=$(git diff --cached --diff-filter=ACM -U0 | grep -E '^\+[^+]' | grep -oE 'AIza[0-9A-Za-z_-]{35}' | sort -u)

if [ -n "$added" ]; then
  for key in $added; do
    permitida=0
    for k in $ALLOWED_KEYS; do
      if [ "$key" = "$k" ]; then
        permitida=1
      fi
    done
    if [ "$permitida" -eq 0 ]; then
      echo ""
      echo "ERROR: Se detecto una Google API Key no permitida en este commit: $key"
      echo "  Si es la clave Firebase de un proyecto propio, anade su apiKey a ALLOWED_KEYS"
      echo "  en .githooks/pre-commit explicando a que proyecto pertenece."
      echo "  Si es un secreto real, muevelo fuera del repositorio."
      exit 1
    fi
  done
fi

# Patrones de secreto genericos en lineas anadidas (excluye las claves conocidas)
if git diff --cached --diff-filter=ACM -U0 | grep -E '^\+[^+]' | grep -vF "AIzaSyDbwAk9APwP2SeaEfWxeQG_bdL9eatciEA" | grep -vF "AIzaSyAeTUIAcqHz0pFuNLpxpg6MiboA-PgdLe4" | grep -Eq "(api[_-]?key|secret|password|token)[[:space:]]*[:=][[:space:]]*['\"][A-Za-z0-9_-]{20,}"; then
  echo ""
  echo "ADVERTENCIA: Posible secreto detectado en el commit. Revisalo antes de continuar."
  exit 1
fi

# Precios y nomenclatura (KONFIO ZINC): bloquea paquetes KZ, planes "START",
# "todo en uno" y cobros mensuales. Solo bloquea por FALLAS, nunca por avisos.
if [ -f herramientas/verificar-precios.js ] && command -v node >/dev/null 2>&1; then
  node herramientas/verificar-precios.js --quiet || {
    echo ""
    echo "COMMIT BLOQUEADO: paquetes KZ, planes START, 'todo en uno' o cobros mensuales."
    echo "Corrige las FALLAS de arriba, o usa 'git commit --no-verify' si sabes por que."
    exit 1
  }
fi

exit 0